# CARDWISE backend configuration
# Copy this file to .env and adjust. Never commit real secrets.

# Where the SQLite database and uploaded statements live (gitignored).
CARDWISE_DATA_DIR=./data

# Port the API listens on.
PORT=8787

# Comma-separated list of allowed browser origins (CORS).
CARDWISE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size in megabytes for a single statement PDF.
CARDWISE_MAX_UPLOAD_MB=15

# Set to "true" only if you have reviewed and enabled an external AI
# categorization provider. Statement data is never sent externally by default.
CARDWISE_ENABLE_AI=false

# Optional external AI provider endpoint (disabled unless ENABLE_AI=true).
# CARDWISE_AI_ENDPOINT=
# CARDWISE_AI_API_KEY=

# Auth mode for V1: "local" (single local profile, no password) is the default.
CARDWISE_AUTH_MODE=local

# CardAdvisor integration (data: CC BY 4.0, https://cardadvisor.in/developers).
# The open dataset needs no key; import with
#   npm --workspace server run import:cardadvisor
# CARDWISE_CARDADVISOR_DATASET_URL=
# CARDWISE_CARDADVISOR_API_BASE=
# A key unlocks the richer "stated" view. Never commit a real key.
# CARDWISE_CARDADVISOR_KEY=
